# Diff de referencia de los parches a Spotlight
#
# Generado contra spotlight@nin version 2026.11 (14).
# NO lo apliques con 'patch': usa scripts/50-spotlight-patches.sh, que hace
# sustituciones idempotentes y aguanta mejor los cambios de version.
# Esto esta aqui para que se vea de un vistazo que se toca y por que.

--- a/extension.js
+++ b/extension.js
@@ -9,9 +9,8 @@
     enable() {
         this._settings = this.getSettings();
         this._popup = new SpotlightPopup(this._settings);
-        // Steal the overview search widgets permanently. The overview search stays gone
-        // for as long as Spotlight is loaded, which is the whole point of the extension.
-        this._popup.stealOverviewSearch();
+        // Parche local 2026-09-17: el robo de widgets se hace solo mientras el popup
+        // esta abierto, para no romper la rejilla de aplicaciones de la vista general.
         this._keybindingManager = new KeybindingManager();
         this._keybindingManager.enable();
         const shortcuts = this._settings.get_strv('toggle-shortcut');
