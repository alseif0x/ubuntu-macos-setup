@@ -52,9 +52,16 @@
 
     _center(popupWidth, monitor) {
         const [, naturalHeight] = this._popup.get_preferred_height(popupWidth);
+        // Parche local 2026-09-17: anclado al tercio superior, como Spotlight en macOS,
+        // en lugar del centro vertical. Se respeta un margen minimo con el borde superior.
+        const top = Math.max(
+            monitor.y + 60,
+            Math.floor(monitor.y + monitor.height * 0.18),
+        );
+        const maxTop = monitor.y + Math.max(0, monitor.height - naturalHeight - 40);
         this._popup.set_position(
             Math.floor(monitor.x + (monitor.width - popupWidth) / 2),
-            Math.floor(monitor.y + (monitor.height - naturalHeight) / 2),
+            Math.floor(Math.min(top, maxTop)),
         );
     }
 
